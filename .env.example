# ============================================================
# 环境变量样例 —— 复制为 .env 后填写（.env 已被 .gitignore 忽略）
# 变量名与 pydantic-settings 字段一一对应
# ============================================================

# ---- LLM（OpenAI 兼容三件套）----
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=sk-请填写
# 推理模型的推理 token 也计入 max_tokens，生成类调用预算给足
LLM_MAX_TOKENS=1200
# 带证据回答的预算（最多 8 个步骤 + 每步引用；太小会把最后一步截断）
LLM_ANSWER_MAX_TOKENS=2600
LLM_TIMEOUT_SECONDS=60

# ---- 数据库（docker-compose 内 app 用 host=db；本机直连用 127.0.0.1:5435）----
DATABASE_URL=postgresql://moqian:moqian@127.0.0.1:5435/moqian_cbecom
POSTGRES_USER=moqian
POSTGRES_PASSWORD=moqian
POSTGRES_DB=moqian_cbecom

# ---- 检索（Dense + BM25 → RRF）----
RETRIEVAL_TOP_K_DENSE=20
RETRIEVAL_TOP_K_BM25=20
RETRIEVAL_RERANK_CANDIDATES=30
RETRIEVAL_FINAL_TOP_N=12
RETRIEVAL_RRF_K=60
RETRIEVAL_MIN_SCORE=0.35
# 过滤后命中少于该数量 → 回退全库检索（纪律 2 的延伸）
RETRIEVAL_MIN_FILTERED_HITS=3

# ---- 证据门（机制在 modules、规则由 app 注入）----
# 纪律：证据不足必须拒答；三条硬指标任一不满足都走 gap
EVIDENCE_MIN_HITS=1
EVIDENCE_MIN_COVERAGE=0.5

# ---- 重排（默认关闭；已实测腾讯云 AI Search /v1/rerank）----
# none = 只用 RRF；tencent = 腾讯云 AI Search；llama_cpp = 本地 llama-server（预留）
RERANKER_PROVIDER=none
RERANKER_MODEL=bge-reranker-v2-m3
# RERANKER_BASE_URL=https://bj.aisearch.tencentelasticsearch.com/v1
# RERANKER_API_KEY=腾讯云 AI Search 的 API Key
# RERANKER_TIMEOUT_SECONDS=10

# ---- 身份（阈值 80%，不自动开通工号）----
IDENTITY_RECOGNIZABLE_THRESHOLD=0.8
IDENTITY_AUTO_PROVISION=false

# ---- 治理域认证（JWT HS256）----
# 生产必须改！留默认值只用于本机演示
JWT_SECRET=dev-only-change-me-please-32bytes!
JWT_TTL_MINUTES=480

# ---- 初始管理员（首次启动 app.seed_admin 建档；口令只从环境变量读）----
ADMIN_INITIAL_ACCOUNT=admin
ADMIN_INITIAL_NAME=系统管理员
# 留空则跳过建档（服务照常启动）
ADMIN_INITIAL_PASSWORD=

# ---- /chat 模式 ----
# pipeline：检索 + 证据门 + 引用校验，正式问答
# skeleton：直连模型验证链路，输出带「骨架模式」标识、不带引用（只用于自检）
CHAT_MODE=pipeline

# ---- 工具调用（mock 订单/物流查询）----
# 超时阈值（秒）：超时/失败一律走降级话术 + 转人工，禁止模型推测事实
TOOL_TIMEOUT_SECONDS=5
# 演示故障注入（X-Demo-Fault: tool_timeout|not_found）；生产关闭
DEMO_FAULT_ENABLED=false

# ---- 多语言输出层 ----
# 英文知识库为唯一口径；en/es 上界面，fr/de 仅评测覆盖
SUPPORTED_LOCALES=en,es,fr,de

# ---- 转人工（四类硬转词表与开关在后台 app_config，这里只配文案）----
HANDOFF_HOTLINE=support@wanderbrim.com
HANDOFF_HOURS=Mon–Fri 9:00–17:00 MST

# ---- 任务 worker ----
TASK_POLL_SECONDS=2
TASK_HEARTBEAT_SECONDS=15
TASK_STALE_SECONDS=120
TASK_MAX_ATTEMPTS=3

# ---- embedding（本机 Ollama 的 OpenAI 兼容端点，bge-m3 返回 1024 维）----
# 本机直跑：http://localhost:11434/v1
# 容器内跑：docker-compose 已覆盖为 http://host.docker.internal:11434/v1
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_DIM=1024
# EMBEDDING_API_KEY=        # Ollama 默认不需要
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=120

# ---- 文档入库 ----
# 原件目录，相对仓库根；容器内挂载为 /app/data
DATA_DIR=data
DOC_INGEST_CHUNK_MAX_CHARS=700
DOC_INGEST_CHUNK_MIN_CHARS=120
# 扫描件（抽不出文字）直接判失败并提示需 OCR
DOC_INGEST_REJECT_SCANNED=true

# ---- 登录验证码 / 知识自测入口（可被后台 config 覆盖）----
CAPTCHA_ENABLED=false
PREVIEW_ENABLED=true

# ---- 运行 ----
APP_ENV=dev
LOG_LEVEL=INFO

# ---- 镜像构建（可选）----
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# 可选：公开演示配额（默认关闭）；入口码不是身份认证
DEMO_ENABLED=false
# DEMO_REQUIRE_CODE=true
# DEMO_SESSION_TURNS=6
# DEMO_IP_DAILY=20
# DEMO_GLOBAL_DAILY=200
# DEMO_BOOKING_URL=https://your-support.example
# EMBEDDING_BASE_URL_DOCKER=http://host.docker.internal:11434/v1

# 环境标识仅用于显示；导入自己的资料后请按实际数据来源修改
APP_ENV_LABEL=本地环境（虚构演示数据）
